  m_Script: {fileID: 11500000, guid: 8d44279b3fc34cb5a05798cced51db58, type: 3}
  m_Name: JoeWhatTrucks
  m_EditorClassIdentifier: Assembly-CSharp::Main.Scripts.Dialogue
  lines:
  - type: 0
    speaker: Joey
    text: What's going on with those trucks out there?
    choices: []
    choiceActionIds: []
    rewardIds: []
  - type: 0
    speaker: Wise Joe
    text: The truck drivers are going on strike.
    choices: []
    choiceActionIds: []
    rewardIds: []
  - type: 0
    speaker: Wise Joe
    text: And the young knuckleheads think crashing their trucks into each other
      will solve the problem.
    choices: []
    choiceActionIds: []
    rewardIds: []
  - type: 0
    speaker: Wise Joe
    text: Delinquents...
    choices: []
    choiceActionIds: []
    rewardIds: []
  - type: 0
    speaker: Joey
    text: Do they not have legitimate unions here?
    choices: []
    choiceActionIds: []
    rewardIds: []
  - type: 0
    speaker: Wise Joe
    text: CITYBOY-
    choices: []
    choiceActionIds: []
    rewardIds: []
  - type: 0
    speaker: 
    text: '[Cut]'
    choices: []
    choiceActionIds: []
    rewardIds: []
  - type: 0
    speaker: Wise Joe
    text: The kids here just ain't educated to know about labor unions.
    choices: []
    choiceActionIds: []
    rewardIds: []
  - type: 0
    speaker: Joey
    text: I can see that.
    choices: []
    choiceActionIds: []
    rewardIds: []
